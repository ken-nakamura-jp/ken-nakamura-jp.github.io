<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.url == '/' %}{{ page.title | escape }} · {% endunless %}
      {{ site.title | escape }}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip | escape }}">
    <meta name="color-scheme" content="light dark">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:title" content="{{ page.title | escape }} · {{ site.title | escape }}">
    <meta property="og:description" content="{{ page.description | default: site.description | strip | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ site.data.profile.portrait | absolute_url }}">
    <link rel="preload" href="{{ '/assets/fonts/source-sans-3/SourceSans3-Regular.woff' | relative_url }}" as="font" type="font/woff" crossorigin>
    <link rel="stylesheet" href="{{ '/assets/css/profile.css' | relative_url }}">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {% include profile/header.liquid %}
    <div class="page-layout">
      {% include profile/sidebar.liquid %}
      <main id="content" tabindex="-1">{{ content }}</main>
    </div>
    <footer class="site-footer">
      © {{ 'now' | date: '%Y' }}
      {{ site.data.profile.name | escape }}. All rights reserved.
    </footer>
  </body>
</html>
